generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PlatformRole {
  SUPER_ADMIN_KYC
  ADMIN_KYC
}

enum CmsRole {
  PRESIDENT
  VICE_PRESIDENT
  TREASURER
  VICE_TREASURER
  SECRETARY
}

enum TenantRole {
  OWNER
  MEMBER
}

model User {
  id              String             @id @default(cuid())
  name            String
  email           String?            @unique
  password        String?
  nim             String?

  platformRole    PlatformRole?

  // KYC Admin fields
  address         String?            @db.Text
  phone           String?
  ktpStorageKey   String?
  kycStatus       KycAdminStatus     @default(PENDING)

  // Portfolio fields
  image           String?
  isVerified      Boolean            @default(false)
  bio             String?            @db.Text
  workExperience  String?            @db.Text
  skills          String?            @db.Text
  instagramUrl    String?
  githubUrl       String?
  linkedinUrl     String?
  websiteUrl      String?

  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  tenantMemberships TenantMembership[]
  ownerApplications OwnerApplication[]
  memberApplications MemberApplication[]

  cashPayments    CashPayment[]
  submissions     Submission[]
  seminarSubmissions SeminarSubmission[]

  // Information feed relations
  informations    Information[]
  comments        Comment[]
  reactions       Reaction[]
  readMarks       ReadMark[]

  @@map("users")
}

enum KycAdminStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

model University {
  id        String         @id @default(cuid())
  name      String
  slug      String         @unique
  programs  StudyProgram[]
  tenants   Tenant[]
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@map("universities")
}

model StudyProgram {
  id           String       @id @default(cuid())
  universityId String
  name         String
  slug         String
  university   University   @relation(fields: [universityId], references: [id], onDelete: Cascade)
  tenants      Tenant[]
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@unique([universityId, slug])
  @@map("study_programs")
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum SubscriptionPlan {
  FREE
  PAID
}

model Tenant {
  id             String             @id @default(cuid())
  universityId   String
  programId      String
  name           String
  slug           String
  customSlug     String?

  status         TenantStatus       @default(ACTIVE)
  subscriptionPlan SubscriptionPlan @default(FREE)
  subscriptionEndsAt DateTime?
  subscriptionGraceEndsAt DateTime?
  subscriptionNoticeSentAt DateTime?
  subscriptionExpiredNoticeSentAt DateTime?
  university       University          @relation(fields: [universityId], references: [id], onDelete: Restrict)
  program          StudyProgram        @relation(fields: [programId], references: [id], onDelete: Restrict)
  memberships      TenantMembership[]
  applications     OwnerApplication[]
  memberApplications MemberApplication[]
  tasks            Task[]
  cashPayments     CashPayment[]
  seminars         Seminar[]
  schedules        Schedule[]
  transactions     Transaction[]
  categories       Category[]
  uangKasSchedules UangKasSchedule[]
  cmsAccessPermissions CmsAccessPermission[]
  informations     Information[]
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  @@unique([programId, slug])
  @@map("tenants")
}

model TenantMembership {
  id        String     @id @default(cuid())
  userId    String
  tenantId  String
  role      TenantRole

  cmsRole   CmsRole?

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt DateTime   @default(now())

  @@unique([userId, tenantId])
  @@map("tenant_memberships")
}

enum OwnerApplicationStatus {
  PENDING_EMAIL
  PENDING_KYC
  APPROVED
  REJECTED
  CANCELLED
}

model OwnerApplication {
  id               String                @id @default(cuid())
  userId           String
  tenantId         String?
  universityName   String
  programName      String
  className        String
  customSlug       String?
  selfieStorageKey String
  ktmStorageKey    String?
  whatsappNumber   String?
  status           OwnerApplicationStatus @default(PENDING_EMAIL)
  submittedAt      DateTime?
  reviewedAt       DateTime?
  reviewedBy       String?
  rejectionReason  String?
  user             User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant           Tenant?               @relation(fields: [tenantId], references: [id])
  reviews          KycReview[]
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  @@map("owner_applications")
}

enum MemberApplicationStatus {
  PENDING_APPROVAL
  APPROVED
  REJECTED
}

model MemberApplication {
  id                     String                  @id @default(cuid())
  userId                 String
  tenantId               String
  fullName               String
  nim                    String?
  email                  String?
  profilePhotoStorageKey String
  ktmPhotoStorageKey     String
  status                 MemberApplicationStatus @default(PENDING_APPROVAL)
  rejectionReason        String?
  reviewedAt             DateTime?
  reviewedBy             String?
  user                   User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant                 Tenant                  @relation(fields: [tenantId], references: [id])
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt

  @@unique([userId, tenantId])
  @@map("member_applications")
}

enum KycDecision {
  APPROVED
  REJECTED
}

model KycReview {
  id            String      @id @default(cuid())
  applicationId String
  adminUserId   String
  decision      KycDecision
  reason        String
  createdAt     DateTime    @default(now())
  application   OwnerApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@map("kyc_reviews")
}

model AuditLog {
  id          String   @id @default(cuid())
  actorUserId String?
  action      String
  entityType  String
  entityId    String?
  metadata    Json?
  createdAt   DateTime @default(now())

  @@map("audit_logs")
}

model Task {
  id          String       @id @default(cuid())
  tenantId    String
  title       String
  description String?
  url         String?
  category    String       @default("E_LEARNING")
  startDate   DateTime     @default(now())
  deadline    DateTime
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  submissions Submission[]
  pertemuan   Pertemuan[]

  @@index([tenantId])
  @@map("tasks")
}

model Pertemuan {
  id        String   @id @default(cuid())
  taskId    String
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  task      Task       @relation(fields: [taskId], references: [id], onDelete: Cascade)
  submissions Submission[]

  @@index([taskId])
  @@map("pertemuan")
}

model Submission {
  id        String   @id @default(cuid())
  taskId    String
  userId    String
  status    String   @default("PENDING")
  submittedAt DateTime @default(now())
  pertemuanId String?

  task      Task       @relation(fields: [taskId], references: [id], onDelete: Cascade)
  pertemuan Pertemuan? @relation(fields: [pertemuanId], references: [id], onDelete: SetNull)
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([taskId, userId, pertemuanId])
  @@map("submissions")
}

model CashPayment {
  id          String   @id @default(cuid())
  tenantId    String
  userId      String
  amount      Float
  description String?
  date        DateTime @default(now())

  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("cash_payments")
}

model Seminar {
  id          String             @id @default(cuid())
  tenantId    String
  title       String
  description String?
  url         String?
  date        DateTime
  location    String?
  createdAt   DateTime           @default(now())

  tenant      Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  submissions SeminarSubmission[]

  @@index([tenantId])
  @@map("seminars")
}

model SeminarSubmission {
  id          String   @id @default(cuid())
  seminarId   String
  userId      String
  status      String   @default("SUBMITTED")
  submittedAt DateTime @default(now())

  seminar     Seminar @relation(fields: [seminarId], references: [id], onDelete: Cascade)
  user        User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([seminarId, userId])
  @@map("seminar_submissions")
}

model Schedule {
  id          String   @id @default(cuid())
  tenantId    String
  title       String
  date        DateTime
  time        String?
  location    String
  type        String   @default("MEETING")
  createdAt   DateTime @default(now())

  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("schedules")
}

model Transaction {
  id          String    @id @default(cuid())
  tenantId    String
  type        String
  amount      Float
  description String
  date        DateTime  @default(now())
  createdBy   String?
  invoiceUrl  String?
  userId      String?
  categoryId  String?

  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  category    Category? @relation(fields: [categoryId], references: [id])

  @@index([tenantId])
  @@map("transactions")
}

model Category {
  id          String       @id @default(cuid())
  tenantId    String
  name        String
  type        String
  createdAt   DateTime     @default(now())

  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@index([tenantId])
  @@map("categories")
}

model UangKasSchedule {
  id          String   @id @default(cuid())
  tenantId    String
  date        DateTime
  amount      Float    @default(10000)
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("uang_kas_schedules")
}

model VerificationToken {
  id              String   @id @default(cuid())
  tokenHash       String   @unique
  email           String
  expiresAt       DateTime?
  createdAt       DateTime @default(now())
  newPasswordHash String?
  purpose         String   @default("MEMBER_PASSWORD_RESET")

  @@map("verification_tokens")
}

model CmsAccessPermission {
  id          String   @id @default(cuid())
  tenantId    String
  cmsRole     CmsRole
  module      String   // e.g., "finance", "tasks", "people", "seminar", "schedule", "audit"
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, cmsRole, module])
  @@index([tenantId])
  @@map("cms_access_permissions")
}

// Information Feed Models
enum InformationType {
  IMAGE
  VIDEO
  PDF
  TEXT
}

model Information {
  id          String           @id @default(cuid())
  tenantId    String
  userId      String
  title       String
  content     String           @db.Text
  type        InformationType
  mediaUrl    String?
  mediaPublicId String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  tenant      Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  comments    Comment[]
  reactions   Reaction[]
  readMarks   ReadMark[]

  @@index([tenantId])
  @@index([createdAt])
  @@map("informations")
}

model Comment {
  id              String    @id @default(cuid())
  informationId   String
  userId          String
  parentId        String?
  content         String    @db.Text
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  information     Information @relation(fields: [informationId], references: [id], onDelete: Cascade)
  user            User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent          Comment?    @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies         Comment[]   @relation("CommentReplies")

  @@index([informationId])
  @@index([parentId])
  @@map("comments")
}

enum ReactionType {
  LIKE
  LOVE
  LAUGH
  WOW
  SAD
  ANGRY
}

model Reaction {
  id            String        @id @default(cuid())
  informationId String
  userId        String
  type          ReactionType
  createdAt     DateTime      @default(now())

  information   Information   @relation(fields: [informationId], references: [id], onDelete: Cascade)
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([informationId, userId])
  @@index([informationId])
  @@map("reactions")
}

model ReadMark {
  id            String    @id @default(cuid())
  informationId String
  userId        String
  readAt        DateTime  @default(now())

  information   Information @relation(fields: [informationId], references: [id], onDelete: Cascade)
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([informationId, userId])
  @@index([informationId])
  @@index([userId])
  @@map("read_marks")
}